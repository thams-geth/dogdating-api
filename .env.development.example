NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://waggle:waggle@localhost:5433/waggle

# Development sign-in only. Request any valid supported phone and use 000000.
OTP_MODE=development
AUTH_SECRET=

# Private local files are opt-in; never expose this directory as static content.
MEDIA_MODE=disabled
MEDIA_LOCAL_DIR=.local/media-development
# Hosted development: use s3 and set the private bucket and its AWS region.
# MEDIA_MODE=s3
# MEDIA_BUCKET=waggle-dev-media-your-account-id
# MEDIA_REGION=ap-south-1

# Optional development-only discovery and chat. Enable deliberately.
DISCOVERY_MODE=disabled
MESSAGE_KEY=

# Optional Firebase Cloud Messaging development project.
# FCM_PROJECT_ID=your-dev-firebase-project

# Optional development staff identity provider. Set all three together.
# STAFF_ISSUER=https://identity.example.com/
# STAFF_JWKS_URL=https://identity.example.com/.well-known/jwks.json
# STAFF_AUDIENCE=waggle-dev-staff
