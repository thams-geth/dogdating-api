@baseUrl = http://localhost:3000
@phone = +919000100000
@deviceId = 11111111-1111-4111-8111-111111111111
@otp = REPLACE_FROM_LOCAL_TERMINAL
@accessToken = REPLACE_FROM_VERIFY_RESPONSE
@refreshToken = REPLACE_FROM_VERIFY_RESPONSE

### Configuration
GET {{baseUrl}}/v1/app/bootstrap?platform=android&buildNumber=1&countryCode=IN&locale=en-IN

### Request OTP; requires npm run setup:dev locally
POST {{baseUrl}}/v1/auth/otp/request
Content-Type: application/json

{"phoneE164":"{{phone}}","countryCode":"IN"}

### Verify / sign up; replace OTP with local terminal code
POST {{baseUrl}}/v1/auth/otp/verify
Content-Type: application/json

{"phoneE164":"{{phone}}","code":"{{otp}}","deviceId":"{{deviceId}}","displayName":"Test Guardian"}

### Read private profile
GET {{baseUrl}}/v1/me
Authorization: Bearer {{accessToken}}

### Edit allowed fields
PATCH {{baseUrl}}/v1/me
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"displayName":"My Name","locale":"en-IN","timezone":"Asia/Kolkata"}

### Refresh; replace both saved tokens after this request. Reusing old refresh revokes the family.
POST {{baseUrl}}/v1/auth/refresh
Content-Type: application/json

{"refreshToken":"{{refreshToken}}"}

### Own device sessions
GET {{baseUrl}}/v1/auth/sessions
Authorization: Bearer {{accessToken}}

### Logout
POST {{baseUrl}}/v1/auth/logout
Authorization: Bearer {{accessToken}}

### Resume onboarding (missing steps come from the server)
GET {{baseUrl}}/v1/me/onboarding
Authorization: Bearer {{accessToken}}

### Save guardian declaration; this is NOT identity verification
PUT {{baseUrl}}/v1/me/onboarding/preferences
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"countryCode":"IN","locale":"en-IN","mode":"pack","adultDeclared":true}

### Read reviewed current terms; 404 until a document is published
GET {{baseUrl}}/v1/legal/documents/terms?countryCode=IN&locale=en-IN

### Preferences
PATCH {{baseUrl}}/v1/me/preferences
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"readReceipts":false,"discoveryPaused":true}

### Create your household (response supplies householdId)
POST {{baseUrl}}/v1/households
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"name":"My pack"}

@householdId = REPLACE_FROM_HOUSEHOLD_RESPONSE
@dogId = REPLACE_FROM_DOG_RESPONSE
@breedId = REPLACE_FROM_BREED_CATALOGUE

### Create a private dog draft
POST {{baseUrl}}/v1/dogs
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"householdId":"{{householdId}}","name":"Ruby","sex":"female","sizeClass":"medium","dateOfBirth":"2023-01-01","neutered":true}

### Set declared breed mix
PUT {{baseUrl}}/v1/dogs/{{dogId}}/breeds
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"breeds":[{"breedId":"{{breedId}}","percentage":100}]}

### Save self-reported temperament, questionnaire version 1
PUT {{baseUrl}}/v1/dogs/{{dogId}}/temperament
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"questionnaireVersion":1,"energy":3,"playStyle":["parallel"],"dogReactivity":2,"humanReactivity":2,"resourceGuarding":1,"recallReliability":3,"sizeTolerance":["medium"],"needsToKnow":"Prefers quiet walks."}

### Weekly schedule; Sunday is 0, times are minutes since local midnight
PUT {{baseUrl}}/v1/dogs/{{dogId}}/availability
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"timezone":"Asia/Kolkata","windows":[{"dayOfWeek":1,"startMin":1080,"endMin":1140}]}

### Select the draft to see its remaining onboarding requirements
PUT {{baseUrl}}/v1/me/active-dog
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"dogId":"{{dogId}}"}

### Invite a co-guardian; caller shares the returned token manually, no SMS is sent
POST {{baseUrl}}/v1/households/{{householdId}}/invitations
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"phoneE164":"+919000100001","role":"co_guardian"}

### Publish is blocked until current consent, media, location and verification prerequisites are met
POST {{baseUrl}}/v1/dogs/{{dogId}}/publish
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{}

### Reserve a private photo (replace bytes/hash with values from your local photo)
POST {{baseUrl}}/v1/dogs/{{dogId}}/media/uploads
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"contentType":"image/jpeg","sizeBytes":12345,"sha256":"REPLACE_WITH_64_LOWERCASE_HEX_SHA256"}

### Upload original bytes, using the id returned by the reservation
PUT {{baseUrl}}/v1/media/{{mediaId}}/content
Authorization: Bearer {{accessToken}}
Content-Type: image/jpeg

< ./test-photo.jpg

### Complete upload (still pending moderation)
POST {{baseUrl}}/v1/media/{{mediaId}}/complete
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{}

### List private photo metadata
GET {{baseUrl}}/v1/dogs/{{dogId}}/media
Authorization: Bearer {{accessToken}}

### Request guardian verification (intent only until a provider is configured)
POST {{baseUrl}}/v1/verifications
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"kind":"guardian"}

### Request dog verification
POST {{baseUrl}}/v1/verifications
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"kind":"dog","dogId":"{{dogId}}"}

### Save self-reported vaccination metadata (never grants a badge)
POST {{baseUrl}}/v1/dogs/{{dogId}}/health-records
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"recordType":"rabies","testedAt":"2026-01-01","expiresAt":"2027-01-01"}

### Read private health records
GET {{baseUrl}}/v1/dogs/{{dogId}}/health-records?limit=20
Authorization: Bearer {{accessToken}}

### Public coarse area lookup
GET {{baseUrl}}/v1/app/areas?countryCode=IN&query=Bengaluru&limit=20

### Save city selection after accepting the current location document
PUT {{baseUrl}}/v1/households/{{householdId}}/location
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"source":"manual_area","areaId":"01920000-0000-7000-8000-0000000e0001"}

### Read private city selection
GET {{baseUrl}}/v1/households/{{householdId}}/location
Authorization: Bearer {{accessToken}}

### Clear shared household location (does not withdraw personal consent)
DELETE {{baseUrl}}/v1/households/{{householdId}}/location
Authorization: Bearer {{accessToken}}

### Block a known guardian (replace targetUserId)
POST {{baseUrl}}/v1/me/blocks
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"userId":"{{targetUserId}}"}

### List own outgoing blocks
GET {{baseUrl}}/v1/me/blocks?limit=20
Authorization: Bearer {{accessToken}}

### Home: current dog, missing tasks and honest section availability
GET {{baseUrl}}/v1/home
Authorization: Bearer {{accessToken}}

### Explicit whole-city opt-in (PUT replaces preference values; include any other desired filters)
PUT {{baseUrl}}/v1/dogs/{{dogId}}/preferences
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"allowCityOnly":true}

### Development feed (requires explicit server configuration and current eligibility)
GET {{baseUrl}}/v1/feed?dogId={{dogId}}&mode=pack&limit=20
Authorization: Bearer {{accessToken}}

### Discovery profile: token must come from this actor's feed card
GET {{baseUrl}}/v1/dogs/{{targetDogId}}/profile?dogId={{dogId}}&impressionToken={{impressionToken}}
Authorization: Bearer {{accessToken}}
