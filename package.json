{
  "name": "dogdating-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/unit/*.test.ts",
    "migrate": "tsx src/db/migrate.ts",
    "test:integration": "node --import tsx --test --test-concurrency=1 test/integration/*.test.ts",
    "setup:dev": "node scripts/setup-dev.mjs",
    "check:openapi": "node scripts/check-openapi.mjs",
    "media:cleanup": "tsx src/modules/media/cleanup.ts",
    "docs:handovers": "node scripts/generate-handovers.mjs",
    "check:handovers": "node scripts/generate-handovers.mjs --check",
    "discovery:cleanup": "tsx src/modules/discovery/cleanup.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "jose": "^6.2.12",
    "pg": "^8.13.1",
    "sharp": "^0.35.5",
    "ws": "^8.22.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.2",
    "supertest": "^7.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "yaml": "^2.9.1"
  }
}
