{
  "name": "dogdating-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file=.env.development --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:dev": "node --env-file=.env.development dist/server.js",
    "start:prod": "node --env-file=.env.production dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/unit/*.test.ts",
    "migrate": "node dist/db/migrate.js",
    "migrate:dev": "node --env-file=.env.development --import tsx src/db/migrate.ts",
    "migrate:prod": "node --env-file=.env.production dist/db/migrate.js",
    "test:integration": "node --import tsx --test --test-concurrency=1 test/integration/*.test.ts",
    "setup:dev": "node scripts/setup-dev.mjs",
    "setup:prod-env": "node scripts/setup-production-env.mjs",
    "check:openapi": "node scripts/check-openapi.mjs",
    "media:cleanup": "node --env-file=.env.development --import tsx src/modules/media/cleanup.ts",
    "docs:handovers": "node scripts/generate-handovers.mjs",
    "check:handovers": "node scripts/generate-handovers.mjs --check",
    "discovery:cleanup": "node --env-file=.env.development --import tsx src/modules/discovery/cleanup.ts",
    "staff:provision": "node --env-file=.env.development --import tsx src/modules/admin/provision.ts",
    "privacy:exports": "node --env-file=.env.development --import tsx src/modules/safety/export-worker.ts",
    "meetups:reminders": "node --env-file=.env.development --import tsx src/modules/meetups/reminder-cli.ts",
    "maintenance:run": "node --env-file=.env.development --import tsx src/modules/ops/maintenance-cli.ts",
    "verification:expire": "node --env-file=.env.development --import tsx src/modules/verification/expiry-cli.ts",
    "push:deliver": "node --env-file=.env.development --import tsx src/modules/notifications/fcm-cli.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "google-auth-library": "^11.2.0",
    "jose": "^6.2.12",
    "pg": "^8.13.1",
    "sharp": "^0.35.5",
    "ws": "^8.22.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.2",
    "supertest": "^7.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "yaml": "^2.9.1"
  }
}
