NODE_ENV=production
PORT=3000

# Required: inject a TLS-enabled production PostgreSQL URL through the hosting
# secret manager. Leave blank locally so accidental production startup fails.
DATABASE_URL=

# These development adapters are deliberately unavailable in production.
OTP_MODE=disabled
MEDIA_MODE=disabled
DISCOVERY_MODE=disabled
AUTH_SECRET=
MESSAGE_KEY=

# Configure only after their production providers and credentials exist.
# FCM_PROJECT_ID=your-production-firebase-project
# STAFF_ISSUER=https://identity.example.com/
# STAFF_JWKS_URL=https://identity.example.com/.well-known/jwks.json
# STAFF_AUDIENCE=waggle-production-staff
