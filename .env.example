NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://waggle:waggle@localhost:5433/waggle
# Explicitly opt in to local terminal OTP delivery; unavailable in production.
# In development, request +919000000001 and use 000000 for sign-in only.
OTP_MODE=disabled
AUTH_SECRET=
# Private local photos are opt-in and forbidden in production.
MEDIA_MODE=disabled
MEDIA_LOCAL_DIR=.local/media
# Metadata-only discovery development opt-in; production remains disabled.
DISCOVERY_MODE=disabled
# Separate local message wrapping key: 32 random bytes encoded as lowercase hex.
# Disabled when empty; local wrapping is forbidden in production.
MESSAGE_KEY=
# Staff SSO: set all three together; HTTPS and recent MFA required.
# Leave unset until an external identity provider and staff subjects are approved.
# STAFF_ISSUER=https://identity.example.com/
# STAFF_JWKS_URL=https://identity.example.com/.well-known/jwks.json
# STAFF_AUDIENCE=waggle-staff
